<Project>

  <PropertyGroup>
    <Version>1.0.0-alpha.17</Version>
    <PackageReleaseNotes>1.0.0-alpha.17: NativeAOT-safe source-generated frame codecs; CR-0009 Anchor failover; CR-0010 bidirectional Bridge ingress; NIP Phase-3 policy enforcement; NOP delegation and result-retention controls; SQLitePCLRaw 2.1.12 security update.</PackageReleaseNotes>
    <!-- XML documentation files are generated, but the alpha SDK still has broad
         public-surface doc gaps; keep compile output clean until the doc sweep. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS1734</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)CHANGELOG.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
