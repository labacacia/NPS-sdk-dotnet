<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="innolotus_nexus" value="https://nexus.ds01.lablotus.com/repository/innolotus/index.json" protocolVersion="3" />
  </packageSources>
  <!-- NSec.Cryptography is only on nuget.org; the private feed returns 404 for it.
       Map it explicitly so NuGet does not query the private feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="NSec.Cryptography" />
      <package pattern="*" />
    </packageSource>
    <packageSource key="innolotus_nexus">
      <package pattern="NPS.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
