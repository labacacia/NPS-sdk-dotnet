<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <HasNpsDaemonSources Condition="Exists('..\..\..\..\tools\daemons\npsd\Npsd.csproj')">true</HasNpsDaemonSources>
    <HasNpsDaemonSources Condition="'$(HasNpsDaemonSources)' == ''">false</HasNpsDaemonSources>
    <NpsSuiteRoot Condition="Exists('..\..\..\..\spec\conformance\node-profile-case-inventory.json')">..\..\..\..</NpsSuiteRoot>
    <NpsSuiteRoot Condition="'$(NpsSuiteRoot)' == '' And Exists('..\..\spec\conformance\node-profile-case-inventory.json')">..\..</NpsSuiteRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasNpsDaemonSources)' != 'true'">
    <Compile Remove="Daemons\**\*.cs" />
    <Compile Remove="Conformance\AdvertisedImplementationManifestTests.cs" />
    <Compile Remove="Conformance\NodeProfileCaseInventoryTests.cs" />
    <Compile Remove="Conformance\NpsdNodeL1ManifestTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- npsd is an ASP.NET Core Web app; tests need WebApplication / IServiceCollection
         from Microsoft.AspNetCore.App to host it via TestServer. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(NpsSuiteRoot)\spec\conformance\node-profile-case-inventory.json">
      <Link>conformance\node-profile-case-inventory.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NpsSuiteRoot)\spec\conformance\node-profile-implementation-manifests.json">
      <Link>conformance\node-profile-implementation-manifests.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(NpsSuiteRoot)\spec\conformance\aaas-l2-requirement-disposition.json">
      <Link>conformance\aaas-l2-requirement-disposition.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\tools\daemons\npsd\conformance\NPS-NODE-L1-MANIFEST.json" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\implementation\NPS-NODE-L1-MANIFEST.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\tools\daemons\nps-ingress\conformance\NPS-NODE-L2-TLS-EVIDENCE.json" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\implementation\NPS-NODE-L2-TLS-EVIDENCE.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\tools\daemons\nps-runner\conformance\NPS-NODE-L3-MANIFEST.json" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\implementation\NPS-NODE-L3-MANIFEST.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-Node-L1.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-Node-L1.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-Node-L1.cn.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-Node-L1.cn.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-Node-L2.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-Node-L2.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-Node-L2.cn.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-Node-L2.cn.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-NODE-L1-CERTIFIED.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-NODE-L1-CERTIFIED.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-NODE-L1-CERTIFIED.cn.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-NODE-L1-CERTIFIED.cn.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-NODE-L2-CERTIFIED.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-NODE-L2-CERTIFIED.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\..\spec\services\conformance\NPS-NODE-L2-CERTIFIED.cn.md" Condition="'$(HasNpsDaemonSources)' == 'true'">
      <Link>conformance\spec\NPS-NODE-L2-CERTIFIED.cn.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NPS.Core\NPS.Core.csproj" />
    <ProjectReference Include="..\..\src\NPS.NWP\NPS.NWP.csproj" />
    <ProjectReference Include="..\..\src\NPS.NWP.Bridge\NPS.NWP.Bridge.csproj" />
    <ProjectReference Include="..\..\src\NPS.NWP.Anchor\NPS.NWP.Anchor.csproj" />
    <ProjectReference Include="..\..\src\NPS.NOP\NPS.NOP.csproj" />
    <ProjectReference Include="..\..\src\NPS.NIP\NPS.NIP.csproj" />
    <ProjectReference Include="..\..\src\NPS.NIP.Storage.Sqlite\NPS.NIP.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\NPS.NDP\NPS.NDP.csproj" />
    <ProjectReference Include="..\..\src\NPS.Conformance\NPS.Conformance.csproj" />
    <ProjectReference Include="..\..\src\NPS.Daemon.Observability\NPS.Daemon.Observability.csproj" />
    <ProjectReference Include="..\..\benchmarks\NPS.Benchmarks.TokenSavings\NPS.Benchmarks.TokenSavings.csproj" />
    <ProjectReference Include="..\..\benchmarks\NPS.Benchmarks.WireSize\NPS.Benchmarks.WireSize.csproj" />
    <ProjectReference Include="..\..\samples\NPS.Samples.NopDag\NPS.Samples.NopDag.csproj" />
    <ProjectReference Include="..\..\..\..\tools\daemons\npsd\Npsd.csproj" Condition="'$(HasNpsDaemonSources)' == 'true'" />
    <ProjectReference Include="..\..\..\..\tools\daemons\nps-registry\NpsRegistry.csproj" Condition="'$(HasNpsDaemonSources)' == 'true'" />
    <ProjectReference Include="..\..\..\..\tools\daemons\nps-ledger\NpsLedger.csproj" Condition="'$(HasNpsDaemonSources)' == 'true'" />
  </ItemGroup>

</Project>
