<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <HasNpsDaemonSources Condition="Exists('..\..\..\..\tools\daemons\npsd\Npsd.csproj')">true</HasNpsDaemonSources>
    <HasNpsDaemonSources Condition="'$(HasNpsDaemonSources)' == ''">false</HasNpsDaemonSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(HasNpsDaemonSources)' != 'true'">
    <Compile Remove="Daemons\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- npsd is an ASP.NET Core Web app; tests need WebApplication / IServiceCollection
         from Microsoft.AspNetCore.App to host it via TestServer. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NPS.Core\NPS.Core.csproj" />
    <ProjectReference Include="..\..\src\NPS.NWP\NPS.NWP.csproj" />
    <ProjectReference Include="..\..\src\NPS.NWP.Bridge\NPS.NWP.Bridge.csproj" />
    <ProjectReference Include="..\..\src\NPS.NWP.Anchor\NPS.NWP.Anchor.csproj" />
    <ProjectReference Include="..\..\src\NPS.NOP\NPS.NOP.csproj" />
    <ProjectReference Include="..\..\src\NPS.NIP\NPS.NIP.csproj" />
    <ProjectReference Include="..\..\src\NPS.NIP.Storage.Sqlite\NPS.NIP.Storage.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\NPS.NDP\NPS.NDP.csproj" />
    <ProjectReference Include="..\..\src\NPS.Conformance\NPS.Conformance.csproj" />
    <ProjectReference Include="..\..\src\NPS.Daemon.Observability\NPS.Daemon.Observability.csproj" />
    <ProjectReference Include="..\..\benchmarks\NPS.Benchmarks.TokenSavings\NPS.Benchmarks.TokenSavings.csproj" />
    <ProjectReference Include="..\..\benchmarks\NPS.Benchmarks.WireSize\NPS.Benchmarks.WireSize.csproj" />
    <ProjectReference Include="..\..\samples\NPS.Samples.NopDag\NPS.Samples.NopDag.csproj" />
    <ProjectReference Include="..\..\..\..\tools\daemons\npsd\Npsd.csproj" Condition="'$(HasNpsDaemonSources)' == 'true'" />
    <ProjectReference Include="..\..\..\..\tools\daemons\nps-registry\NpsRegistry.csproj" Condition="'$(HasNpsDaemonSources)' == 'true'" />
    <ProjectReference Include="..\..\..\..\tools\daemons\nps-ledger\NpsLedger.csproj" Condition="'$(HasNpsDaemonSources)' == 'true'" />
  </ItemGroup>

</Project>
